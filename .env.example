# Copy to .env.local for local work. Real values live in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). The publishable/anon key is safe in the browser:
# row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used by lib/db/admin.ts (e.g. the register-interest
# Server Action) and edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, used for auth redirects and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile on the register-interest form. Optional: leave BOTH empty to switch
# it off (the form still works, with the honeypot). The secret is server only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — TEST MODE ONLY until Kate signs off (sk_test_..., pk_test_...). Phase 2.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
