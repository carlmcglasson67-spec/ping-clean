# Copy to .env.local for local work. Real values live in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). The publishable/anon key is safe in the browser:
# row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used by lib/db/admin.ts and edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, used for auth redirects and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — TEST MODE ONLY until Kate signs off (sk_test_..., pk_test_...). Phase 2.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Server only. Signs the 15-minute password-reset pass (lib/auth/recovery.ts). REQUIRED in
# production, at least 32 random characters: without it, password resets are switched off.
# Make one with: openssl rand -hex 32   (a different value for Preview and Production)
RESET_PASS_SECRET=
