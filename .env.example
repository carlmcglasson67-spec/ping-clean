# Copy to .env.local for local work. Real values live in Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). The publishable/anon key is safe in the browser:
# row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used by lib/db/admin.ts (e.g. the register-interest
# Server Action) and edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# Public site address, used for auth redirects and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile on the register-interest form. Optional: leave BOTH empty to switch
# it off (the form still works, with the honeypot). The secret is server only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — TEST MODE ONLY until Kate signs off. The app refuses to start Stripe with anything
# but a test key (lib/stripe/keys.ts), and refuses live-mode webhook events.
# STRIPE_SECRET_KEY=sk_test_...                  (server only)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secrets, one per endpoint (Stripe dashboard → Developers → Webhooks):
#   https://<site>/api/stripe/webhook          → STRIPE_WEBHOOK_SECRET (Ping's own account)
#   https://<site>/api/stripe/connect-webhook  → STRIPE_CONNECT_WEBHOOK_SECRET (connected accounts)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# The charge job (app/api/stripe/charge-due): the database's cron sends this secret with every
# call. Server only, 32+ random characters (openssl rand -hex 32). The same value goes in
# Supabase Vault as ping_job_secret, with ping_charge_job_url = https://<site>/api/stripe/charge-due.
# The payout job (app/api/stripe/payouts-due) uses the same secret and the same Vault entries:
# nothing more to set up.
# PING_JOB_SECRET=
# Tests only: send Stripe requests to a local fake instead (127.0.0.1 or localhost only).
# STRIPE_API_BASE=http://127.0.0.1:12111

# Server only. Signs the 15-minute password-reset pass (lib/auth/recovery.ts). REQUIRED in
# production, at least 32 random characters: without it, password resets are switched off.
# Make one with: openssl rand -hex 32   (a different value for Preview and Production)
RESET_PASS_SECRET=

# Emails to customers about payments (lib/notify/email.ts), sent through Resend. Server only.
# Leave both empty and no email is sent: the notices wait in the queue.
# PING_EMAIL_FROM must be an address on a domain verified in Resend.
# RESEND_API_KEY=re_...
# PING_EMAIL_FROM=Ping Clean <hello@pingclean.co.uk>
